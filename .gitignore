# ==========================================
# 1. Monorepo Root, IDEs & OS Files
# ==========================================
.DS_Store
Thumbs.db
*.log
*.swp
*.history
.history/

# IntelliJ / Android Studio / VS Code
*.iml
*.ipr
*.iws
.idea/
.vscode/
!.vscode/settings.json

# Environment & Secret Files (CRITICAL)
.env
*.env
backend/.env
frontend/.env


# ==========================================
# 2. Node.js / Backend Ignores
# ==========================================
backend/node_modules/
backend/dist/
backend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ==========================================
# 3. Flutter / Dart Ignores
# ==========================================
# Build & Tool Cache (Matches everywhere)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/
**/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Native Android Ignores
**/android/local.properties
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/build/

# Native iOS / macOS / Linux Ephemeral Files
**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/


# ==========================================
# 4. Miscellaneous & System
# ==========================================
*.class
*.pyc
.build/
.buildlog/
.svn/
.swiftpm/
